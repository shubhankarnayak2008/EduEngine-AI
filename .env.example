# ============================================================
# Google Gemini API Key (Server-Side Only - NEVER expose to browser)
# ============================================================
# HOW TO GET: https://aistudio.google.com/app/apikey
# Both new "AQ...." and legacy "AIzaSy..." keys are fully supported.
GEMINI_API_KEY=

# ============================================================
# YouTube Data API v3 Key (Optional - for live video search)
# ============================================================
# HOW TO GET: https://console.cloud.google.com/apis/credentials
# Without this key, the app automatically shows verified curated B.Tech lectures
YOUTUBE_API_KEY=